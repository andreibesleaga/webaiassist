{
  "config": {
    "default": true,
    "MD013": false,
    // A changelog repeats "Added", "Changed" and "Known limits" under each version.
    "MD024": { "siblings_only": true },
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "dist/**",
    "dist-smoke/**",
    "vendor/**",
    "coverage/**",
    "test-results/**",
    ".features-gen/**",
    "playwright-report/**",
    ".claude/**",
  ],
}
