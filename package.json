{
  "name": "webaiassist",
  "version": "0.1.0",
  "private": true,
  "description": "A local AI model in your side panel that uses the WebMCP tools of the open page. Works with AgenticSystemCore nodes.",
  "license": "Apache-2.0",
  "author": "Andrei N. Besleaga",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/check-dist.mjs",
    "gen:validators": "node scripts/gen-validators.ts",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "lint:md": "markdownlint-cli2",
    "check:core-boundary": "tsc -p tsconfig.core.json && eslint --max-warnings 0 src/core",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "spike:serve": "node scripts/serve-spike.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:core-boundary && npm run check:scenarios && npm run test:coverage && npm run lint:md",
    "build:smoke": "node scripts/build.mjs --smoke && node scripts/check-dist.mjs --smoke",
    "test:smoke": "npm run build:smoke && playwright test",
    "screenshots": "npm run build:smoke && WEBAIASSIST_SCREENSHOTS=1 playwright test test/smoke/screenshots.spec.ts",
    "test:bdd": "npm run build:smoke && bddgen -c playwright.bdd.config.ts && playwright test -c playwright.bdd.config.ts",
    "scenarios": "node scripts/scenarios.mjs",
    "check:scenarios": "node scripts/scenarios.mjs --check",
    "build:eval": "node scripts/build.mjs --eval && node scripts/check-dist.mjs --eval",
    "eval:gpu": "npm run build:eval && node scripts/eval/run.ts",
    "eval:gpu:win": "node scripts/eval/win.ts",
    "eval:cpu": "npm run build:eval && node scripts/eval/cpu.ts",
    "eval:nano": "npm run build:eval && node scripts/eval/nano.ts",
    "eval:nano:win": "node scripts/eval/win.ts --script eval:nano",
    "zip": "node scripts/zip.mjs",
    "icons": "node scripts/make-icons.mjs",
    "promo": "node scripts/make-promo.mjs",
    "check:zip": "node scripts/check-zip.mjs",
    "verify:release": "npm run verify && npm run build && npm run zip && npm run check:zip && npm run test:smoke && npm run test:bdd"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@mlc-ai/web-llm": "0.2.86",
    "@w3c/webmcp-polyfill": "0.1.0",
    "@wllama/wllama": "3.8.1",
    "ajv": "8.20.0",
    "idb": "8.0.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.1.43",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "3.2.7",
    "@webgpu/types": "0.1.74",
    "axe-core": "4.14.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.2.6",
    "fflate": "0.8.3",
    "globals": "16.5.0",
    "jsdom": "30.1.3",
    "markdownlint-cli2": "0.18.1",
    "playwright-bdd": "9.2.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
